{
  "name": "narrative-engine",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./lab": "./dist/lab.js"
  },
  "bin": {
    "narrativeengine": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run build:server && npm run build:ui",
    "build:ui": "cd lab && npm run build",
    "build:server": "tsup src/index.ts src/cli.ts src/lab.ts --format cjs,esm --dts",
    "check": "tsc --noEmit",
    "dev": "NODE_ENV=development tsx bin/cli.ts -- lab"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.27",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "tsup": "^8.0.1",
    "typescript": "5.6.3",
    "vite": "^8.0.2"
  }
}
