{
  "name": "narrative-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-dependency, mathematically deterministic engine for narrative-driven contextual storytelling with Hybrid RAG pipeline",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "narrativeengine": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && npm run build:server && npm run build:cli",
    "build:server": "tsup",
    "build:cli": "tsup --config tsup.cli.ts",
    "check": "tsc --noEmit",
    "dev": "NODE_ENV=development tsx bin/cli.ts -- lab"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.27",
    "concurrently": "^8.2.2",
    "rolldown": "^1.0.0-rc.12",
    "tsup": "^8.0.1",
    "typescript": "5.6.3"
  }
}
