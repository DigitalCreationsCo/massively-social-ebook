#!/bin/bash

# Run the release guard only when this push targets main.
#
# The refs being pushed arrive on stdin, one per line:
#   <local ref> SP <local sha> SP <remote ref> SP <remote sha>
# The remote ref is the third field, and it is the only reliable source of
# truth here: argv carries just <remote> <url>, so a hook that inspects argv
# cannot tell what is being pushed and skips the guard whenever main is pushed
# while standing on some other branch.
#
# Older git passed the refspecs as trailing arguments instead, so argv is still
# consulted when stdin carries nothing, and HEAD's upstream is the last resort
# when neither is available.
pushing_main=false
saw_refs=false

while read -r local_ref local_sha remote_ref remote_sha; do
  saw_refs=true
  if [ "$remote_ref" = "refs/heads/main" ]; then
    pushing_main=true
    break
  fi
done

if [ "$saw_refs" = false ] && [ "$#" -ge 6 ]; then
  # legacy: <remote> <url> then groups of four beginning at $1
  shift 2
  while [ "$#" -ge 4 ]; do
    if [ "$3" = "refs/heads/main" ]; then
      pushing_main=true
      break
    fi
    shift 2
  done
fi

if [ "$saw_refs" = false ] && [ "$#" -eq 2 ]; then
  # no ref information at all: best effort from what HEAD tracks
  upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
  if [ "$upstream" = "origin/main" ]; then
    pushing_main=true
  fi
fi

if [ "$pushing_main" = true ]; then
  echo "[+] main is being pushed. running pre-push release validation..."
  sh scripts/check-version.sh
else
  echo "[+] not pushing main. skipping release validation."
fi
