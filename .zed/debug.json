[
  {
    "label": "Debug TSX Server (watch + breakpoints)",
    "adapter": "JavaScript",
    "type": "node",
    "request": "launch",
    "runtimeExecutable": "./node_modules/.bin/tsx",
    "args": ["watch", "-r", "dotenv/config", "server/index.ts"],
    "env": {
      "NODE_ENV": "development",
      "DOTENV_CONFIG_PATH": ".env.local"
    },
    "sourceMaps": true,
    "skipFiles": ["<node_internals>/**"],
    "restart": true
  },
  {
    "label": "Debug Current File (Javascript)",
    "type": "node",
    "adapter": "JavaScript",
    "request": "launch",
    "runtimeExecutable": "node",
    "runtimeArgs": ["--import", "tsx"],
    "program": "$ZED_FILE",
    "skipFiles": ["<node_internals>/**"],
    "use_new_terminal": true,
    "envFile": "${workspaceFolder}/.env.local",
    "cwd": "/Users/vibrantceo/Projects/portals/massively-social-ebook",
    "sourceMaps": true
  }
]
