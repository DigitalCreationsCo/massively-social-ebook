DATABASE_URL=""
DATABASE_SSL=""

ADMIN_TOKEN="your-admin-token"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-admin-password"

GEMINI_API_KEY=""

# AI SDK provider routing. Individual capability settings override AI_PROVIDER.
# Providers: google (or gemini), openai, opencode. Defaults preserve Gemini.
AI_PROVIDER="google"
# AI_TEXT_PROVIDER="opencode"
# AI_TEXT_MODEL="google/gemini-2.5-flash"
# AI_IMAGE_PROVIDER="openai"
# AI_IMAGE_MODEL="gpt-image-1.5"
# AI_EMBEDDING_PROVIDER="openai"
# AI_EMBEDDING_MODEL="text-embedding-3-small"
# The schema stores vector(768); change this only alongside a database migration.
AI_EMBEDDING_DIMENSIONS="768"

# Google accepts GOOGLE_GENERATIVE_AI_API_KEY; GEMINI_API_KEY remains supported.
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""

# OpenCode models use the configured OpenCode server and provider credentials.
# AI_TEXT_MODEL must be in provider/model format, e.g. google/gemini-2.5-flash.
OPENCODE_BASE_URL=""
OPENCODE_AUTO_START_SERVER="true"
OPENCODE_SERVER_TIMEOUT_MS="10000"

# PX skill source. At startup/build, the app resolves the exact git commit that
# produced the locked @portalshq/nap-sdk package, downloads this file from that
# commit, and saves it under server/blocks/generated/ for runtime use.
PX_SKILL_GITHUB_PATH=""
# Required only when the nap repository/skill file is private.
PX_SKILL_GITHUB_TOKEN=""

# App URL for absolute links in emails/cal
APP_URL=""
VITE_TTS_API_URL=""

# Email notifications
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Google Calendar (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_BUCKET=""

# Google Cloud Storage emulator endpoint (for local development only)
# Set this to use a local GCS emulator instead of production GCS
# Example: GCS_EMULATOR_ENDPOINT="http://localhost:7999"
GCS_EMULATOR_ENDPOINT=""

# Azure/Outlook (Client Credentials)
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""
VITE_MIXPANEL_TOKEN=""

# NAP (Narrative Asset Protocol) Configuration
# Lore HTTP server URL for NAP operations (presigning, entity resolution)
NAP_LORE_HTTP_URL=""
# Alternative HTTP server URL for NAP operations
NAP_HTTP_URL=""
# Lore HTTP authentication token
NAP_LORE_HTTP_TOKEN=""
# Lore gRPC authentication token
NAP_LORE_GRPC_TOKEN=""
# Generic bearer token for NAP operations
NAP_BEARER_TOKEN=""
# Environment variable name containing the NAP token
NAP_TOKEN_ENV=""
# NAP repository branch (for local development)
NAP_BRANCH=""
# NAP repository commit (for local development)
NAP_COMMIT=""
# NAP presign TTL in seconds
NAP_PRESIGN_TTL_SECONDS=""

# Narrative Engine Lab
NARRATIVE_VERBOSE=true

# Text-to-Speech (Hugging Face)
# HF_TTS_API_URL may point to a Space root or its /gradio_api/call path.
HF_TTS_API_URL=""
HF_TOKEN=""
# Bark speaker/voice preset. This is not narrative context and must remain server-only.
TTS_HISTORY_PROMPT="Speaker 1 (en)"

# Optional API key for the /api/tts/generate endpoint.
# If set, requests must include `x-tts-api-key: <value>` header.
# If unset, the endpoint is open (rate-limited to 10 req/min/IP).
TTS_API_KEY=""

# Live broadcast registry. Queue tokens and provider OAuth credentials are
# referenced by environment-variable name so secrets never appear in JSON,
# API responses, logs, or browser bundles.
# `controlEndpoint` is the Streamer's authenticated FastAPI API (normally :8000),
# not the public HLS manifest/listener on :8888.
# BROADCAST_CHANNELS_JSON='{"your-channel-id":{"controlEndpoint":"http://localhost:8000","queueTokenEnv":"BROADCAST_QUEUE_TOKEN"}}'
BROADCAST_CHANNELS_JSON=""
BROADCAST_QUEUE_TOKEN=""

# Archive/replay public URL when GOOGLE_CLOUD_BUCKET is not configured. The
# streamer does not fetch this media during normal direct queue ingestion.
PUBLIC_BASE_URL=""

# Queue/media safety controls (seconds/milliseconds respectively).
BROADCAST_MAX_SEGMENT_SECONDS="25"
# Duration used when an image succeeds but TTS exhausts its retries.
BROADCAST_IMAGE_ONLY_DURATION_SECONDS="5"
BROADCAST_FETCH_TIMEOUT_MS="15000"
BROADCAST_UPLOAD_TIMEOUT_MS="120000"
# Ambient lookahead bounds. A turn is staged before playout and released only
# when the reserved FIFO duration cannot delay the next scheduled episode.
BROADCAST_AMBIENT_READY_SECONDS="30"
BROADCAST_AMBIENT_MAX_PREPARED_BYTES="52428800"
BROADCAST_AMBIENT_MAX_IN_FLIGHT_GENERATIONS="1"
BROADCAST_AMBIENT_SAFETY_MARGIN_MS="2000"
TTS_REQUEST_TIMEOUT_MS="120000"

# Optional provider connector secrets. Reference these names from the matching
# youtube/twitch object inside BROADCAST_CHANNELS_JSON.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_REFRESH_TOKEN=""
