DATABASE_URL=""
DATABASE_SSL=""

ADMIN_TOKEN="your-admin-token"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-admin-password"

GEMINI_API_KEY=""

# AI SDK provider routing. Individual capability settings override AI_PROVIDER.
# Providers: google (or gemini), openai, opencode, huggingface (or hf), openrouter.
AI_PROVIDER="google"
# AI_TEXT_PROVIDER="opencode"
# AI_TEXT_MODEL="google/gemini-2.5-flash"
# AI_IMAGE_PROVIDER="openai"
# AI_IMAGE_MODEL="gpt-image-1.5"
# Direct Vertex GenAI image generation; supports multiple image references.
# AI_IMAGE_PROVIDER="google"
# AI_IMAGE_MODEL="gemini-2.5-flash-image"
# GOOGLE_VERTEX_LOCATION="global"
# OpenRouter image generation via its dedicated Images API.
# AI_IMAGE_PROVIDER="openrouter"
# AI_IMAGE_MODEL="meta/muse-image"
# Batched image fan-out pacing (4-8 different prompts per batch).
# IMAGE_BATCH_CONCURRENCY="4"
# IMAGE_BATCH_INTERVAL_MS="1000"
# Hugging Face image generation through the fal-ai routed provider.
# AI_IMAGE_PROVIDER="huggingface"
# AI_IMAGE_MODEL="black-forest-labs/FLUX.2-dev"
# AI_TEXT_PROVIDER="openrouter"
# AI_TEXT_MODEL="minimax/minimax-m3:free"
# AI_EMBEDDING_PROVIDER="openai"
# AI_EMBEDDING_MODEL="text-embedding-3-small"
# The schema stores vector(768); change this only alongside a database migration.
AI_EMBEDDING_DIMENSIONS="768"

# Google accepts GOOGLE_GENERATIVE_AI_API_KEY; GEMINI_API_KEY remains supported.
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
HF_TOKEN=""

# OpenCode models use the configured OpenCode server and provider credentials.
# AI_TEXT_MODEL must be in provider/model format, e.g. google/gemini-2.5-flash.
OPENCODE_BASE_URL=""
OPENCODE_AUTO_START_SERVER="true"
OPENCODE_SERVER_TIMEOUT_MS="10000"

# PX skill source. At startup/build, the app resolves the exact git commit that
# produced the locked @portalshq/px package, downloads this file from that
# commit, and saves it under server/blocks/generated/ for runtime use.
PX_SKILL_GITHUB_PATH=""
# Required only when the px repository/skill file is private.
PX_SKILL_GITHUB_TOKEN=""

# App URL for absolute links in emails/cal
APP_URL=""
PUBLIC_APP_URL=""

# ── Monetization ─────────────────────────────────────────────────────────────
# All payment logic lives in @portalshq/monetization. This app supplies config
# only; it never calls Stripe directly. See docs/monetization.md.
#
# STRIPE_SECRET_KEY must be a RESTRICTED key (rk_...) on the platform account,
# not a secret key. The platform is merchant of record: it holds the end-user
# Customer and creates destination charges, so this key needs charge and customer
# write access plus Connect read. Test keys only until the settle path is
# verified end to end.
STRIPE_SECRET_KEY=""
# From `stripe listen` or the webhook endpoint's signing secret. Without it the
# /api/monetization/webhook route returns 503 and purchases never settle.
STRIPE_WEBHOOK_SECRET=""

# The publication: one Connect account receives money for every channel it runs.
MONETIZATION_TENANT_ID="25th-chapter"
# Platform rake per purchase, in cents. Never exposed to the client.
MONETIZATION_FEE_CENTS="10"
# How often the settlement outbox is drained. Below 1000 is ignored.
MONETIZATION_DRAIN_INTERVAL_MS="5000"
# Required by POST /api/monetization/drain and /outbox/replay. Leave empty to
# leave those two routes unauthenticated — only safe on a private deployment.
MONETIZATION_DRAIN_TOKEN=""

# Optional Portalshq metering endpoint; events are fire-and-forget.
OPENMETER_ENDPOINT=""

VITE_TTS_API_URL=""

# Email notifications
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Google Calendar (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_BUCKET=""

# Google Cloud Storage emulator endpoint (for local development only)
# Set this to use a local GCS emulator instead of production GCS
# Example: GCS_EMULATOR_ENDPOINT="http://localhost:7999"
GCS_EMULATOR_ENDPOINT=""

# Azure/Outlook (Client Credentials)
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""
VITE_MIXPANEL_TOKEN=""

# PX (Narrative Asset Protocol) Configuration
# Lore server URL base (e.g., lore://localhost:8700 or lore://100.105.14.118:41337)
PX_LORE_URL_BASE=""
# Explicit Lore HTTP origin for presigned URLs (e.g., http://127.0.0.1:41339 or http://100.105.14.118:41339).
# In production Lore is behind TLS, so this is https://... and presigned URLs are HTTPS.
PX_LORE_HTTP_URL=""

# Allowlist for story image reference downloads (comma-separated hostnames, no
# scheme/path). Presigned URLs may point at object storage OR the Lore HTTP
# origin depending on the storage backend, so include BOTH hosts when set —
# an explicit list replaces the built-in defaults entirely.
# Allowlisted hosts are fetchable over HTTP or HTTPS (presigned URLs are bearer
# capabilities: only allowlist HTTP origins on trusted networks). Loopback is
# always blocked in production.
# Production (storage + Lore behind TLS):
# IMAGE_REFERENCE_ALLOWED_HOSTS="storage.googleapis.com,<bucket>.storage.googleapis.com,storage.cloud.google.com,lore.example.com"
# Local dev (Lore over plain HTTP; unset also works via defaults + loopback):
# IMAGE_REFERENCE_ALLOWED_HOSTS="100.105.14.118,localhost,127.0.0.1"
IMAGE_REFERENCE_ALLOWED_HOSTS=""

# Repository-scoped bearer token for Lore HTTP presign requests
PX_LORE_HTTP_TOKEN=""

# gRPC endpoint for branch ref sync (optional)
PX_LORE_GRPC_ENDPOINT=""

# JWT bearer token for gRPC auth (optional)
PX_LORE_GRPC_TOKEN=""

# Repository ID (hex-encoded) for gRPC (optional)
PX_LORE_GRPC_RID=""

# Skip TLS verification for gRPC (optional, set to 1/true/yes to disable)
PX_LORE_GRPC_INSECURE=""

# Narrative Engine Lab
NARRATIVE_VERBOSE=true

# Text-to-Speech (Hugging Face)
# HF_TTS_API_URL may point to a Space root or its /gradio_api/call path.
HF_TTS_API_URL=""
HF_TOKEN=""
# Bark speaker/voice preset. This is not narrative context and must remain server-only.
TTS_HISTORY_PROMPT="Speaker 1 (en)"

# Optional API key for the /api/tts/generate endpoint.
# If set, requests must include `x-tts-api-key: <value>` header.
# If unset, the endpoint is open (rate-limited to 10 req/min/IP).
TTS_API_KEY=""

# Deployment-local channel registry. It contains channel infrastructure and is
# refreshed with canonical Px manifests at every successful server startup.
# Keep this file writable by the app and out of source control. Use
# channel-registry.example.json as the schema template.
CHANNEL_REGISTRY_PATH="./channel-registry.json"

# Queue tokens and provider OAuth credentials are referenced by environment-
# variable name so secrets never appear in JSON, API responses, logs, or
# browser bundles.
# `controlEndpoint` is the Streamer's authenticated FastAPI API (normally :8000),
# not the public HLS manifest/listener on :8888.
BROADCAST_QUEUE_TOKEN=""

# Archive/replay public URL when GOOGLE_CLOUD_BUCKET is not configured. The
# streamer does not fetch this media during normal direct queue ingestion.
PUBLIC_BASE_URL=""

# Queue/media safety controls (seconds/milliseconds respectively).
BROADCAST_MAX_SEGMENT_SECONDS="25"
# Playout floor for narrated image turns: max(config, narration length).
# Short voice clips hold the image for the full floor; long narration is
# preserved. Applies to imageDuration on image uploads only — video keeps
# its intrinsic duration.
BROADCAST_IMAGE_DURATION_SECONDS="12"
# Image-only turns (narration unavailable) hold this long. Should cover a
# full generation cycle so consumption keeps pace with production.
BROADCAST_IMAGE_ONLY_DURATION_SECONDS="15"
# Narration (TTS) attempts per turn before falling back to an image-only
# turn. Defaults to 1: a dead provider must not stall staging behind doomed
# retries — playback proceeds identically with or without narration.
BROADCAST_NARRATION_ATTEMPTS="1"
BROADCAST_FETCH_TIMEOUT_MS="15000"
BROADCAST_UPLOAD_TIMEOUT_MS="120000"
# Ambient lookahead bounds. A turn is staged before playout and released only
# when the reserved FIFO duration cannot delay the next scheduled episode.
BROADCAST_AMBIENT_READY_SECONDS="60"
BROADCAST_AMBIENT_MAX_PREPARED_BYTES="52428800"
BROADCAST_AMBIENT_MAX_IN_FLIGHT_GENERATIONS="2"
# Distinct visuals buffered staged-or-released ahead of playout (2-3 total).
# Split narration segments share one visual and count as one. The
# Streamer plays FIFO, each slot for its own imageDuration — queue time never
# shortens playback. On empty queue the player holds the last image.
BROADCAST_AMBIENT_BUFFER_SLOTS="3"
BROADCAST_AMBIENT_SAFETY_MARGIN_MS="2000"
TTS_REQUEST_TIMEOUT_MS="25000"

# Story generation controls. Public choices support only the existing A/B
# contract: empty/0 disables decisions, 1 behaves as disabled, 2 enables A/B;
# invalid values fail startup. Internal candidates are hidden quality-selection
# alternatives: empty/0 disables them; 2-4 are valid when implemented.
STORY_DECISION_BRANCHES="0"
STORY_INTERNAL_CANDIDATES="0"

# Video generation (OpenRouter / fal.ai, Veo 3.1). All optional; defaults are
# streaming-friendly (8s, 720p, 16:9 with audio). Veo only supports 16:9 and
# 9:16 — a 1:1 request is normalized to 16:9. fal durations snap to 4s/6s/8s.
# BROADCAST_USE_VIDEO enables video turns; on video failure the pipeline falls
# back to image+audio so playback never stalls.
# BROADCAST_USE_VIDEO="false"
# AI_VIDEO_PROVIDER="openrouter"  # or "fal"
# AI_VIDEO_MODEL="google/veo-3.1"  # or "fal-ai/veo3.1"
# OPENROUTER_API_KEY=""
# FAL_KEY=""
# VIDEO_DURATION_SECONDS="8"
# VIDEO_RESOLUTION="720p"  # 720p, 1080p, or 4k
# VIDEO_ASPECT_RATIO="16:9"  # 16:9 or 9:16 (1:1 maps to 16:9)
# VIDEO_GENERATE_AUDIO="true"
# Timeouts/retries: generation is async and takes 30-60s+.
# VIDEO_GEN_TIMEOUT_MS="180000"
# VIDEO_POLL_INTERVAL_MS="10000"
# VIDEO_POLL_TIMEOUT_MS="300000"
# VIDEO_GEN_MAX_RETRIES="2"
# VIDEO_GEN_RETRY_BASE_MS="1000"
# Quality gates (bytes) and delivery.
# VIDEO_MIN_BYTES="1024"
# VIDEO_MAX_BYTES="100000000"
# VIDEO_CDN_BASE_URL=""  # e.g. https://cdn.example.com; rewrites archive URLs
# Cost controls. Provider-reported usage.cost is preferred when available;
# per-second estimates below align the fallback with real billing.
# VIDEO_DAILY_BUDGET_USD="10"
# VIDEO_COST_OPENROUTER_720P="0.50"
# VIDEO_COST_OPENROUTER_1080P="0.75"
# VIDEO_COST_FAL_720P="0.03"
# VIDEO_COST_FAL_1080P="0.05"
# VIDEO_SAVE_SESSION="true"
# VIDEO_SAVE_AMBIENT="false"
# Mock source for tests only (skips providers entirely).
# BROADCAST_VIDEO_SOURCE=""
# BROADCAST_VIDEO_SOURCE_TYPE="url"  # or "static"
# BROADCAST_VIDEO_MIME_TYPE="video/mp4"

# Optional provider connector secrets. Reference these names from the matching
# youtube/twitch object inside CHANNEL_REGISTRY_PATH's JSON file.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
TWITCH_REFRESH_TOKEN=""
