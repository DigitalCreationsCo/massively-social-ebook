  "scripts": {
    "dev": "rm -rf node_modules/.vite && NODE_ENV=development tsx watch -r dotenv/config server/index.ts",
    "build": "NODE_ENV=production tsx scripts/build.ts",
    "start": "DOTENV_CONFIG_PATH=.env.production.local NODE_ENV=production node -r dotenv/config dist/index.cjs",
    "release:patch": "HUSKY=0 npm version patch && git push origin main --tags",
    "release:minor": "HUSKY=0 npm version minor && git push origin main --tags",
    "release:major": "HUSKY=0 npm version major && git push origin main --tags",
    "check": "tsc",
    "test": "vitest",
    "db:dev": "supabase start",
    "db:push": "drizzle-kit --config drizzle.dev.config.ts push",
    "db:push:prod": "drizzle-kit --config drizzle.prod.config.ts push",
    "prepare": "husky",
    "email:dev": "email dev",
    "clean": "rm -rf node_modules packages/*/node_modules",
    "clean:all": "rm -rf dist packages/*/dist node_modules packages/*/node_modules packages/*/package-lock.json package-lock.json"
  },
